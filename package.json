{
    "name": "@yanqirenshi/table.wbs",
    "version": "0.0.22",
    "description": "See: examples/",
    "main": "dist/cjs/index.js",
    "directories": {
        "doc": "docs",
        "example": "example",
        "test": "tests"
    },
    "scripts": {
        "test": "jest",
        "test:w": "jest --watch",
        "test:coverage": "jest --coverage",
        "transpile": "npm run clean && npm run transpile:esm && npm run transpile:cjs",
        "prepublishOnly": "npm run transpile",
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "transpile:esm": "babel src -d dist --no-babelrc --config-file ./babel.dist.config.js --env-name esm",
        "transpile:cjs": "babel src -d dist/cjs --no-babelrc --config-file ./babel.dist.config.js --env-name cjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yanqirenshi/table.WBS.git"
    },
    "author": "yanqirenshi@gmail.com",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/yanqirenshi/table.WBS/issues"
    },
    "homepage": "https://github.com/yanqirenshi/table.WBS#readme",
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/react-fontawesome": "^3.5.0",
        "@yanqirenshi/wnqi.big.size": "0.0.2",
        "bulma": "^0.9.1",
        "deepmerge": "^4.2.2"
    },
    "devDependencies": {
        "@babel/cli": "^7.13.0",
        "@babel/core": "^7.13.1",
        "@babel/preset-env": "^7.13.0",
        "@babel/preset-react": "^7.12.13",
        "babel-jest": "^25.2.4",
        "babel-loader": "^8.2.2",
        "babel-plugin-transform-es2015-modules-commonjs": "^6.26.2",
        "jest": "^25.2.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "module": "dist/index.js",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./package.json": "./package.json"
    }
}
